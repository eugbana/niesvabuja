{
  "name": "niesv-theme",
  "private": true,
  "description": "Build tooling for the NIESV theme's Tailwind CSS",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --minify",
    "watch": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.9",
    "@tailwindcss/typography": "0.5.15",
    "tailwindcss": "3.4.17"
  }
}
